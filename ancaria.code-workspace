{
    "folders": [
        { "name": "workspace", "path": "." },
        { "name": "mappings", "path": "mappings" },
        { "name": "research", "path": "research" },
        { "name": "coderpack", "path": "coderpack" },
        { "name": "protocol", "path": "protocol" },
        { "name": "launcher", "path": "launcher" },
        { "name": "build", "path": "build" },
        { "name": "mods", "path": "mods" },
        { "name": "idea", "path": "idea" },
        { "name": "site", "path": "site" }
    ],
    "settings": {
        "files.exclude": {
            "mappings": true,
            "research": true,
            "coderpack": true,
            "protocol": true,
            "launcher": true,
            "build": true,
            "mods": true,
            "idea": true,
            "site": true
        },
        "git.detectSubmodules": true,
        "git.openRepositoryInParentFolders": "always",
        "java.compile.nullAnalysis.mode": "automatic"
    },
    "extensions": {
        // Each folder already carries its own .vscode/extensions.json, which VS
        // Code aggregates automatically in a multi-root workspace. This list is
        // the same set, unioned, so the recommendation prompt still fires when
        // Cursor opens this .code-workspace file directly and does not merge
        // per-folder recommendations on its own.
        "recommendations": [
            "editorconfig.editorconfig",
            "redhat.java",
            "vscjava.vscode-java-dependency",
            "vscjava.vscode-gradle",
            "jetbrains.kotlin-server",
            "rust-lang.rust-analyzer",
            "tamasfe.even-better-toml",
            "golang.go",
            "ms-vscode.powershell",
            "ms-python.python",
            "ms-python.vscode-pylance",
            "biomejs.biome"
        ]
    }
}
